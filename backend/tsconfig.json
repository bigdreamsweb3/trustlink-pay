{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "types": [
      "node"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@trustlink/tsn-sdk": [
        "../tsn-protocol/tsn-sdk/dist"
      ],
      "@trustlink/tsn-sdk/*": [
        "../tsn-protocol/tsn-sdk/dist/*"
      ],
      "@trustlink/tsn-cranker-sdk": [
        "../tsn-protocol/tsn-cranker-sdk/src"
      ],
      "@trustlink/tip-sdk": [
        "../transfer-identity-protocol/tip-sdk/src"
      ],
      "@coral-xyz/anchor": [
        "./node_modules/@coral-xyz/anchor"
      ],
      "@solana/spl-token": [
        "./node_modules/@solana/spl-token"
      ],
      "@solana/web3.js": [
        "./node_modules/@solana/web3.js"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "../transfer-identity-protocol/tip-sdk",
    "../tsn-protocol/tsn-cranker-sdk",
    "../tsn-protocol/tsn-sdk",
    ".next",
    ".pytest_cache",
    ".tsn-logs",
    ".venv",
    "__pycache__",
    "archives",
    "build",
    "coverage",
    "dist",
    "firebase-export",
    "frontend",
    "ipfs-data",
    "logs",
    "node_modules",
    "out",
    "runtime",
    "scripts/test-tins-*",
    "target",
    "tests",
    "venv"
  ]
}
