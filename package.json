{
  "name": "trustlink-pay",
  "version": "1.0.0",
  "description": "TrustLink Pay - Identity-first blockchain payments on Solana. Send stablecoins to phone numbers, resolved through TSN privacy-preserving settlement network. Built with WhatsApp auth, Cranker liquidity, and on-chain TINS identity.",
  "keywords": [
    "TrustLink Pay",
    "Solana payments",
    "blockchain payments",
    "mobile money",
    "stablecoin transfer",
    "identity-first payments",
    "TSN Transfer Settlement Network",
    "Cranker settlement",
    "TINS Transfer Identity Number",
    "WhatsApp payments",
    "peer-to-peer payments",
    "cross-border payments",
    "remittance",
    "Solana DeFi",
    "privacy preserving"
  ],
  "homepage": "https://trustlink-pay.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdreamsweb3/trustlink-pay"
  },
  "bugs": {
    "url": "https://github.com/bigdreamsweb3/trustlink-pay/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Agbaka Matthew Daniel aka Big Dreams Web3",
    "url": "https://x.com/0xbigdream",
    "country": "Nigeria"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "// 00-| -----------": "==================================================",
    "// 00-Dev": "==================================================",
    "// 00-0 -----------": "==================================================",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mempool:backend": "cd tsn-mempool-backend && set MEMPOOL_STORE=file&& set PYTHONUNBUFFERED=1&& python -u server.py",
    "dev:mempool:frontend": "cd tsn-mempool-frontend && node ../frontend/node_modules/next/dist/bin/next dev -p 3002",
    "dev:fullstack": "npx concurrently -n backend,frontend -c cyan,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:tsn:stack": "node scripts/start-tsn-mempool-stack.mjs",
    "dev:all:hint": "echo \"Run in separate terminals:\" && echo \"1) npm run dev:backend\" && echo \"2) npm run dev:frontend\" && echo \"3) npm run dev:mempool:backend\" && echo \"4) npm run dev:mempool:frontend\"",
    "flow:check": "node scripts/flow-check.mjs",
    "// 10-| -----------": "==================================================",
    "// 10-TSN Program": "==================================================",
    "// 10-0 -----------": "==================================================",
    "tsn:program:build": "cd tsn/protocol && anchor build",
    "tsn:program:deploy": "cd tsn/protocol && anchor deploy",
    "tsn:program:test": "cd tsn/protocol && anchor test",
    "tsn:program:id": "echo TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V",
    "// 20-| -----------": "==================================================",
    "// 20-Program IDs": "==================================================",
    "// 20-0 -----------": "==================================================",
    "tsn:id:update": "node tsn/update-program-id-tsn.mjs TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V",
    "tins:id:update": "node tins-registrar/update-program-id.mjs TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT",
    "// 25-| -----------": "==================================================",
    "// 25-TSN SDK": "==================================================",
    "// 25-0 -----------": "==================================================",
    "tsn:sdk:build": "npm --prefix tsn-sdk run build",
    "tsn:cranker-sdk:build": "npm --prefix tsn-cranker-sdk run build",
    "tsn:sdk:relink": "npm --prefix frontend install && npm --prefix backend install",
    "tsn:sdk:reinstall:all": "npm --prefix frontend install && npm --prefix backend install && npm --prefix tsn-cranker-sdk install && npm --prefix tsn-cranker-op-daemon install && npm --prefix tsn-mempool-frontend install",
    "tsn:sdk:clean-cache": "node -e \"const fs=require('fs');['frontend/.next'].forEach((p)=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}})\"",
    "tsn:sdk:clean-cache:all": "node -e \"const fs=require('fs');['frontend/.next','backend/.next'].forEach((p)=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}})\"",
    "tsn:sdk:refresh": "npm --prefix tsn-sdk install && npm run tsn:sdk:build && npm --prefix tsn-cranker-sdk install && npm run tsn:cranker-sdk:build && npm run tsn:sdk:reinstall:all && npm run tsn:sdk:clean-cache",
    "tsn:sdk:rebuild:all": "npm run tsn:sdk:refresh",
    "tsn:rebuild:all": "npm run tsn:program:build && npm run tsn:sdk:refresh",
    "tsn:redeploy:all": "node scripts/rebuild-redeploy-all.mjs --skip-tins",
    "rebuild:redeploy:all": "node scripts/rebuild-redeploy-all.mjs",
    "tsn:security:keys": "node scripts/tsn-generate-cranker-encryption-key.mjs",
    "tsn:private:configure": "node scripts/tsn-private-settlement-config.mjs",
    "tsn:security:test": "npm --prefix tsn-sdk test && node scripts/tsn-settlement-security-demo.mjs",
    "tsn:secure:rebuild": "npm run tsn:program:build && npm run tsn:sdk:refresh",
    "tsn:secure:deploy": "npm run tsn:program:build && npm run tsn:program:deploy && npm run tsn:sdk:refresh",
    "tsn:check:types": "npm --prefix tsn-sdk exec -- tsc -p tsconfig.json --noEmit && npm --prefix backend run typecheck && npm --prefix frontend run typecheck && cd tsn-cranker-op-daemon && .\\node_modules\\.bin\\tsc.cmd --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --allowImportingTsExtensions --skipLibCheck scripts\\cranker.ts",
    "tsn:mempool:install": "node scripts/install-tsn-mempool-python.mjs",
    "// 30-| -----------": "==================================================",
    "// 30-Cranker": "==================================================",
    "// 30-0 -----------": "==================================================",
    "tsn:mother:init": "npm --prefix tsn-cranker-op-daemon run mother:init",
    "tsn:cranker:register": "npm --prefix tsn-cranker-op-daemon run register",
    "tsn:mother:migrate": "npm --prefix tsn-cranker-op-daemon run mother:migrate",
    "tsn:cranker:setup": "npm --prefix tsn-cranker-op-daemon run setup",
    "tsn:cranker:start": "npm --prefix tsn-cranker-op-daemon run crank:start",
    "tsn:cranker:help": "npm --prefix tsn-cranker-op-daemon run help",
    "// 35-| -----------": "==================================================",
    "// 35 TSN": "==================================================",
    "// 35-0 -----------": "==================================================",
    "tsn:verifier:info": "node scripts/tsn-verifier-pda.mjs info",
    "tsn:verifier:fund": "node scripts/tsn-verifier-pda.mjs fund",
    "tsn:verifier:fund-cli": "node scripts/tsn-verifier-pda.mjs fund-cli",
    "tsn:verifier:fund-lamports": "node scripts/tsn-verifier-pda.mjs fund-lamports",
    "tsn:verifier:withdraw": "node scripts/tsn-verifier-pda.mjs withdraw",
    "tsn:verifier:withdraw-lamports": "node scripts/tsn-verifier-pda.mjs withdraw-lamports",
    "tsn:treasury:info": "node scripts/tsn-treasury-pda.mjs info",
    "tsn:treasury:ata": "node scripts/tsn-treasury-pda.mjs init-ata",
    "tsn:mempool:status": "node scripts/tsn-mempool-status.mjs",
    "tsn:status:sync": "node scripts/tsn-sync-status.mjs",
    "tsn:mempool:cancel": "node scripts/tsn-cancel-mempool-work.mjs",
    "// 40-| -----------": "==================================================",
    "// 40-TINS": "==================================================",
    "// 40-0 -----------": "==================================================",
    "tins:program:id": "echo TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT",
    "tins:init-global": "node scripts/tins-init-global.mjs",
    "tins:create": "node scripts/tins-create.mjs",
    "tins:lookup": "node scripts/tins-lookup.mjs 1000000008",
    "tins:identity:demo": "npm run tsn:sdk:build && node scripts/tins-identity-encryption-demo.mjs",
    "tins:identity:test": "npm run tins:identity:demo",
    "tins:sdk:build": "npm --prefix tins-sdk run build",
    "tins:build": "cd tins-registrar/program && anchor build",
    "tins:deploy": "cd tins-registrar/program && anchor deploy",
    "// 90-| -----------": "==================================================",
    "// 90-Git": "==================================================",
    "// 90-0 -----------": "==================================================",
    "git:pull:all": "git pull origin main && git submodule update --init --recursive",
    "git:quick:push": "git diff-index --quiet HEAD || (git add . && git commit -m \"Something just got updated!\" --allow-empty && git push origin main)",
    "git:force:push": "git add . && git commit -m \"Something just got updated!\" --no-verify --allow-empty && git push origin main --force",
    "git:commit:push:all": "git add -A && git commit -m \"Update submodules\" && git push --recurse-submodules=on-demand origin main --force"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3"
  }
}
