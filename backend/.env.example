# Database Configuration
DATABASE_URL='postgresql://user:password@host:port/database?sslmode=require&channel_binding=require'

# Redis Configuration
REDIS_URL='redis://localhost:6379'

# Solana Configuration
# HTTP JSON-RPC gateway endpoint (port 8787).
TSN_RPC_GATEWAY_URL='https://tsn-rpc-gateway.vercel.app'
SOLANA_ESCROW_AUTHORITY_SECRET_KEY='[YOUR_KEYPAIR_ARRAY]'
# The backend uses SOLANA_ESCROW_AUTHORITY_SECRET_KEY for claim verification;
# do not duplicate the secret under a second environment variable name.
SOLANA_ALLOWED_SPL_TOKENS=[{"mintAddress":"YOUR_MINT_ADDRESS","symbol":"USDC","name":"USD Coin","logo":"$","decimals":6}]
SOLANA_MOCK_MODE='false'
DATABASE_FETCH_TIMEOUT_MS=20000

# TSN / Proof of Payment (Milestone 4)
TSN_ENABLED='true'
TSN_CREATE_INTENTS_ONCHAIN='true'
TSN_SYNC_ONCHAIN='true'
TSN_STATUS_SYNC_INTERVAL_MS='15000'
TSN_MEMPOOL_URL='http://127.0.0.1:8000'
TSN_MEMPOOL_API_KEY=''
TSN_MEMPOOL_TIMEOUT_MS='4000'
# Required by hosted /api/tsn/sync cron requests.
CRON_SECRET=''
TINS_PROGRAM_ID='TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT'

