# Development - Option 1: Use middleware proxy (recommended)
NEXT_PUBLIC_SITE_URL=https://trustlink-pay.vercel.app

# Development - Option 2: Use direct backend URL (if middleware fails)
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

NEXT_PUBLIC_TSN_SOL_USD=150
NEXT_PUBLIC_TSN_USDC_USD=1
NEXT_PUBLIC_TSN_USDT_USD=1
# Shared HTTP JSON-RPC gateway path for the app on port 8787.
TSN_RPC_GATEWAY_URL=https://tsn-rpc-gateway.wasmer.app
NEXT_PUBLIC_TSN_RPC_GATEWAY_URL=https://tsn-rpc-gateway.wasmer.app
NEXT_PUBLIC_TINS_PROGRAM_ID=TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT
# Legacy single-device envelope compatibility is disabled by default. Enable
# only for a one-time migration/test on the original authorized device.
NEXT_PUBLIC_ALLOW_LEGACY_TIN_DEVICE_ENVELOPE=false
NEXT_PUBLIC_TSN_RECEIVER_URL=https://tsn-receiver-kappa.vercel.app
NEXT_PUBLIC_TSN_CRANKER_FEE_PAYER=
# Public verifier X25519 key generated by: npm run tsn:security:keys
# Alternative single setting:
# NEXT_PUBLIC_TSN_USD_PRICES={"SOL":150,"USDC":1,"USDT":1}

# Production - set NEXT_PUBLIC_BACKEND_URL to your deployed backend URL
# Examples:
# NEXT_PUBLIC_BACKEND_URL=https://trustlink-pay-backend.vercel.app
# NEXT_PUBLIC_BACKEND_URL=https://your-backend-domain.com
# NEXT_PUBLIC_BACKEND_URL=https://api.yourapp.com

NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id
NEXT_PUBLIC_TRUSTLINK_APP_URL=http://localhost:3001
