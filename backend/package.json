{
  "name": "trust-link",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "autoclaim:worker": "tsx scripts/autoclaim-worker.ts",
    "autoclaim:tick": "tsx scripts/autoclaim-worker.ts --once --tick",
    "test:auth-phone-flow": "tsx scripts/test-auth-phone-flow.ts",
    "test:identity-binding": "tsx scripts/test-identity-binding.ts",
    "test:whatsapp-number": "tsx scripts/test-whatsapp-number.ts",
    "test:recipient-lookup": "tsx scripts/test-recipient-lookup.ts",
    "test:payment-flow": "tsx scripts/test-payment-flow.ts",
    "test:tins:phase1": "tsx scripts/test-tins-phase1.ts",
    "tsn:setup": "npm --prefix ../tsn run setup --",
    "tsn:cranker": "npm --prefix ../tsn run cranker --",
    "ngrok:https": "npx ngrok http 3000"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.98.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.0.1",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "chai": "^5.3.3",
    "mocha": "^11.7.2",
    "ts-mocha": "^11.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
