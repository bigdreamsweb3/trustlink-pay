{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@coral-xyz/anchor": ["./node_modules/@coral-xyz/anchor"],
      "@solana/spl-token": ["./node_modules/@solana/spl-token"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"],
      "@trustlink/tsn-sdk": ["../tsn-sdk/dist"],
      "@trustlink/tsn-sdk/*": ["../tsn-sdk/dist/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "frontend", "tests", "../tsn-sdk/src", "../tins-sdk", "scripts/test-tins-phase1.ts", "scripts/test-tins-unbreakable.ts"]
}
