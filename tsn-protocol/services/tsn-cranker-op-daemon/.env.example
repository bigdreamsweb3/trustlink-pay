# Solana operator identity and RPC
# Preferred RPC endpoint. Defaults to TSN's hosted gateway when unset.
TSN_RPC_URL=https://tsn-rpc-gateway.vercel.app
# Optional PubSub override. The local TSN gateway defaults to this same port
# and serves WebSocket subscriptions at /ws (not the next port, 8788).
# TSN_RPC_WS_URL=ws://127.0.0.1:8787/ws
PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TINS_PROGRAM_ID=TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT
KEYPAIR_PATH=./keys/cranker-keypair.json
TSN_CRANKER_KEYPAIR_PATH=./keys/cranker-keypair.json
# Mother authority signs the TSN V2 wrapper; the Cranker operator remains the
# Receiver identity and transaction fee payer. Keep this key in the trusted
# Cranker runtime and ensure it matches the deployed MotherEscrow authority.
TSN_MOTHER_AUTHORITY_KEYPAIR_PATH=./keys/mother-authority-keypair.json

# Prefer an active local Receiver (health-checked at Cranker startup), then use
# the configured hosted Receiver when no local Receiver is ready.
TSN_LOCAL_RECEIVER_URL=http://127.0.0.1:8010
TSN_RECEIVER_URL=https://tsn-receiver-kappa.vercel.app
# Public key pinned by the Cranker to verify Node-signed work receipts.
TSN_NODE_VERIFICATION_PUBLIC_KEY=

# Creditcoin settlement signer and registered route
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CRANKER_KEYPAIR_FILE=../tsn-crosschain/.creds/creditcoin_cranker_keypair.json
CREDITCOIN_SETTLEMENT_HUB=0x29151Ff9266b8Fb15D86D22d73f084F59293438c
CREDITCOIN_LIQUIDITY_REGISTRY=0x764Ac587b1fC0feBEE86012cF7A2489b575EE5D1
CREDITCOIN_ROUTE_ID=0xd1c8fb4fdaa90f4b4cf7f385e0f426c0cc6130ecff6ac078f0c95b91125e3943

# Runtime behavior
TSN_ENABLED=true
TSN_CREATE_INTENTS_ONCHAIN=true
TSN_CRANKER_POLL_MS=2000
TSN_CRANKER_MAX_IDLE_POLL_MS=30000
TSN_CRANKER_WAKE_ENABLED=false
