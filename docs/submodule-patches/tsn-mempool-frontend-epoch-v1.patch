+export type EpochRecord = {
+  id: string;
+  epochId: number;
+  status: "precreated" | "active" | "closing" | "challenge_released" | "reimbursed" | "residual_sweep_ready";
+  startsAt: string;
+  endsAt: string;
+  tokenMintAddress?: string | null;
+  epochAccount?: string | null;
+  pea?: string | null;
+  rootHash: string;
+  totalToDistribute: string;
+  crankerCreditSumMod: string;
+  commitmentCount: number;
+  winnerCrankerPubkey?: string | null;
+  reimbursementTxSig?: string | null;
+  updatedAt: string;
+};
+
+export type EpochChallenge = {
+  id: string;
+  epoch: number;
+  rootHash: string;
+  totalToDistribute: string;
+  crankerCreditSumMod: string;
+  commitmentCount: number;
+  status: "open" | "submitted" | "completed" | "failed";
+  winnerCrankerPubkey?: string | null;
+  reimbursementTxSig?: string | null;
+  updatedAt: string;
+};
+
+const baseUrl = process.env.NEXT_PUBLIC_TSN_MEMPOOL_URL ?? "http://localhost:8787";
+
+export function maskTsnValue(value?: string | null) {
+  if (!value) return "not published";
+  if (value.length <= 12) return value;
+  return `${value.slice(0, 6)}…${value.slice(-6)}`;
+}
+
+async function getJson<T>(path: string): Promise<T> {
+  const response = await fetch(`${baseUrl}${path}`, { cache: "no-store" });
+  if (!response.ok) throw new Error(`TSN mempool request failed: ${response.status}`);
+  return (await response.json()) as T;
+}
+
+export function listEpochs() {
+  return getJson<EpochRecord[]>("/epochs");
+}
+
+export function listEpochChallenges() {
+  return getJson<EpochChallenge[]>("/epoch-challenges");
+}
