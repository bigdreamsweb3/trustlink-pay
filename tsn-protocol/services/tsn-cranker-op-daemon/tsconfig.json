{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "references": [{ "path": "../../sdks/tsn-sdk" }],
  "include": [
    "scripts/**/*",
    "src/**/*.ts",
    "../tsn-crosschain/src/**/*.ts",
    "../../sdks/tsn-sdk/legacy/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
