diff --git a/src/TinsOperationsPanel.tsx b/src/TinsOperationsPanel.tsx
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/TinsOperationsPanel.tsx
@@ -0,0 +1,210 @@
+import { useEffect, useMemo, useState } from "react";
+
+type TinOperationStatus = "pending_verification" | "verified" | "fee_committed" | "submitted" | "completed" | "failed" | "canceled";
+
+type TinOperationIntent = {
+  id: string;
+  kind: "tin_creation" | "tin_update";
+  status: TinOperationStatus;
+  ownerPubkey: string;
+  tin?: string | null;
+  encryptedMetadataHash: string;
+  pruConfigurationHash: string;
+  intentHash: string;
+  feeAmountUsdc: string;
+  feeCommitmentHash?: string | null;
+  feeCommitmentTxSig?: string | null;
+  registryTxSig?: string | null;
+  verifierCrankerPubkey?: string | null;
+  submitterCrankerPubkey?: string | null;
+  postedAt: string;
+  updatedAt: string;
+};
+
+const statusLabels: Record<TinOperationStatus, string> = {
+  pending_verification: "Awaiting Cranker A",
+  verified: "Verified",
+  fee_committed: "Fee committed",
+  submitted: "Registry submitted",
+  completed: "Completed",
+  failed: "Failed",
+  canceled: "Canceled",
+};
+
+function mask(value?: string | null) {
+  if (!value) return "—";
+  return `${value.slice(0, 6)}…${value.slice(-6)}`;
+}
+
+export function TinsOperationsPanel({ mempoolUrl }: { mempoolUrl: string }) {
+  const [items, setItems] = useState<TinOperationIntent[]>([]);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let active = true;
+    async function load() {
+      try {
+        const response = await fetch(`${mempoolUrl.replace(/\/$/, "")}/tin-operations`);
+        if (!response.ok) throw new Error(`TINS operations request failed (${response.status})`);
+        const data = (await response.json()) as TinOperationIntent[];
+        if (active) setItems(data);
+      } catch (err) {
+        if (active) setError(err instanceof Error ? err.message : "Unable to load TINS operations");
+      }
+    }
+    void load();
+    const timer = setInterval(load, 5000);
+    return () => {
+      active = false;
+      clearInterval(timer);
+    };
+  }, [mempoolUrl]);
+
+  const counts = useMemo(() => items.reduce<Record<string, number>>((acc, item) => {
+    acc[item.status] = (acc[item.status] ?? 0) + 1;
+    return acc;
+  }, {}), [items]);
+
+  return (
+    <section aria-labelledby="tins-operations-heading" className="rounded-2xl border border-slate-800 bg-slate-950 p-4 text-slate-100">
+      <div className="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
+        <div>
+          <p className="text-xs uppercase tracking-[0.2em] text-cyan-300">TINS via TSN</p>
+          <h2 id="tins-operations-heading" className="text-xl font-semibold">Cranker-mediated TIN operations</h2>
+          <p className="mt-1 text-sm text-slate-400">Creation and updates are owner-signed intents relayed by Crankers. Raw phone data and PRU lists stay hidden.</p>
+        </div>
+        <div className="grid grid-cols-2 gap-2 text-xs md:grid-cols-4">
+          <span className="rounded-xl bg-slate-900 px-3 py-2">Pending {counts.pending_verification ?? 0}</span>
+          <span className="rounded-xl bg-slate-900 px-3 py-2">Verified {counts.verified ?? 0}</span>
+          <span className="rounded-xl bg-slate-900 px-3 py-2">Fee {counts.fee_committed ?? 0}</span>
+          <span className="rounded-xl bg-slate-900 px-3 py-2">Done {counts.completed ?? 0}</span>
+        </div>
+      </div>
+
+      {error ? <p role="alert" className="mt-4 rounded-xl border border-red-900 bg-red-950/40 p-3 text-sm text-red-200">{error}</p> : null}
+
+      <div className="mt-4 overflow-x-auto">
+        <table className="min-w-full text-left text-sm">
+          <thead className="text-xs uppercase text-slate-500">
+            <tr>
+              <th className="py-2 pr-4">Kind</th>
+              <th className="py-2 pr-4">Status</th>
+              <th className="py-2 pr-4">Owner</th>
+              <th className="py-2 pr-4">PRU commitment</th>
+              <th className="py-2 pr-4">Fee</th>
+              <th className="py-2 pr-4">Crankers</th>
+            </tr>
+          </thead>
+          <tbody>
+            {items.map((item) => (
+              <tr key={item.id} className="border-t border-slate-900">
+                <td className="py-3 pr-4">{item.kind === "tin_creation" ? "TIN creation" : "TIN update"}</td>
+                <td className="py-3 pr-4">{statusLabels[item.status]}</td>
+                <td className="py-3 pr-4 font-mono text-xs">{mask(item.ownerPubkey)}</td>
+                <td className="py-3 pr-4 font-mono text-xs">{mask(item.pruConfigurationHash)}</td>
+                <td className="py-3 pr-4">{item.feeAmountUsdc} USDC</td>
+                <td className="py-3 pr-4 text-xs text-slate-400">A {mask(item.verifierCrankerPubkey)} / B {mask(item.submitterCrankerPubkey)}</td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </section>
+  );
+}
+
+/* Integration point:
+ * Import this panel into the existing mempool explorer dashboard and render it under the TSN Settlement view.
+ * Keep owner pubkeys masked and never render encryptedMasterSeedBase64, ownerSignatureBase64, raw phone numbers, or PRU arrays.
+ */
diff --git a/src/App.tsx b/src/App.tsx
--- a/src/App.tsx
+++ b/src/App.tsx
@@ -1,3 +1,8 @@
+import { TinsOperationsPanel } from "./TinsOperationsPanel";
+
+// Render near existing TSN work queues:
+<TinsOperationsPanel mempoolUrl={import.meta.env.VITE_TSN_MEMPOOL_URL ?? "http://localhost:8000"} />
