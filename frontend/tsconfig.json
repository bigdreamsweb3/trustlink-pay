{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "framer-motion": [
        "./node_modules/framer-motion"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "@/*": [
        "./*"
      ],
      "@/src/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "../utils/**/*.ts",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    ".next",
    ".pytest_cache",
    ".tsn-logs",
    ".venv",
    "__pycache__",
    "archives",
    "build",
    "coverage",
    "dist",
    "firebase-export",
    "ipfs-data",
    "logs",
    "node_modules",
    "out",
    "runtime",
    "target",
    "venv"
  ]
}
