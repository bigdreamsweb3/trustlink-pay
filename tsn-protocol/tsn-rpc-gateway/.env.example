TSN_RPC_GATEWAY_PORT=8787
TSN_RPC_GATEWAY_WS_PORT=8788
TSN_RPC_GATEWAY_MODE=balanced
TSN_RPC_PROVIDER_TIMEOUT_MS=4500

# HTTP JSON-RPC listener for callers
# 8787 = HTTP RPC

# WebSocket listener for Solana subscriptions
# 8788 = WebSocket RPC

# Upstream Solana HTTP RPC providers used by the gateway
TSN_SOLANA_RPC_URLS=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,https://api.devnet.solana.com,https://rpc.ankr.com/solana_devnet

# Optional explicit upstream WebSocket providers.
# If omitted, the gateway derives ws/wss URLs from TSN_SOLANA_RPC_URLS.
# TSN_SOLANA_WS_URLS=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,wss://api.devnet.solana.com
