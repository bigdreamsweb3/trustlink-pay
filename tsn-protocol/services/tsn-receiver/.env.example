# Local environment variables for TSN Receiver service. Copy this file to .env and fill in the values.
TSN_RECEIVER_STORE=file
TSN_RECEIVER_LOCAL_FILE=.receiver-store.json
TSN_ALLOW_LOCAL_JSON_STORE=true

# Live Production environment variables for TSN Receiver service. Copy this file to .env and fill in the values.
TSN_RECEIVER_STORE=firebase
TSN_ALLOW_LOCAL_JSON_STORE=false
TSN_RECEIVER_LOCAL_FILE=.receiver-store.json

# Firebase service account credentials. Required for live deployment.
FIREBASE_PROJECT_ID=tsn-epoch-record
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=

# TSN 
TSN_RECEIVER_COLLECTION=tsn_receiver_work
TSN_RECEIVER_STATE_COLLECTION=tsn_receiver_state
TSN_RECEIVER_CRANKER_CHALLENGE_COLLECTION=tsn_receiver_cranker_challenges
TSN_RECEIVER_CRANKER_RATE_COLLECTION=tsn_receiver_cranker_rate_limits
TSN_RECEIVER_NODE_API_KEY=
# 32-byte hex or base64 key. Required to encrypt payment intents at rest;
# configure the same secret for every Receiver instance.
TSN_RECEIVER_NODE_PAYLOAD_KEY=
# The Receiver verifies each operator against the permissionless on-chain
# Cranker PDA and Mother DNA. No per-Cranker allowlist or API key is used.
TSN_SOLANA_RPC_URL=https://api.devnet.solana.com
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TSN_NODE_URL=http://127.0.0.1:8000
TSN_NODE_FALLBACK_URL=https://tsn-node.wasmer.app
TSN_RECEIVER_PUBLIC_URL=http://127.0.0.1:8010

TSN_NODE_WAKE_TIMEOUT_MS=2500

TSN_SOLANA_RPC_URL=https://tsn-rpc-gateway.vercel.app
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V