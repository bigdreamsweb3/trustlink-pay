+// TINS Cranker-mediated endpoints to add beside existing TSN routes.
+// Import TinOperationRuntime from ./tinsOperations and mount these routes.
+app.post("/tin-operations", async (req, res) => res.json(await tinOperationRuntime.postIntent(req.body)));
+app.get("/tin-operations", async (req, res) => res.json(await tinOperationRuntime.list(req.query.status)));
+app.get("/tin-operations/verification-work", async (req, res) => res.json(await tinOperationRuntime.listVerificationWork(Number(req.query.limit ?? 50))));
+app.get("/tin-operations/fee-work", async (req, res) => res.json(await tinOperationRuntime.listFeeCommitmentWork(Number(req.query.limit ?? 50))));
+app.get("/tin-operations/registry-work", async (req, res) => {
+  const operator = String(req.query.operator_pubkey ?? "");
+  if (!operator) return res.status(400).json({ error: "operator_pubkey required" });
+  res.json(await tinOperationRuntime.listRegistrySubmissionWork(operator, Number(req.query.limit ?? 50)));
+});
+app.patch("/tin-operations/:id/verified", async (req, res) => res.json(await tinOperationRuntime.markVerified(req.params.id, req.body.verifierCrankerPubkey)));
+app.patch("/tin-operations/:id/fee-committed", async (req, res) => res.json(await tinOperationRuntime.markFeeCommitted(req.params.id, req.body.feeCommitmentTxSig)));
+app.patch("/tin-operations/:id/submitted", async (req, res) => res.json(await tinOperationRuntime.markSubmitted(req.params.id, req.body.submitterCrankerPubkey, req.body.registryTxSig)));
+app.patch("/tin-operations/:id/completed", async (req, res) => res.json(await tinOperationRuntime.markCompleted(req.params.id)));
