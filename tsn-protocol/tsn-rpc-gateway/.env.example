# Cloud hosts supply PORT. Set TSN_RPC_GATEWAY_PORT only for a fixed local port.
TSN_RPC_GATEWAY_PORT=8787
TSN_RPC_GATEWAY_MODE=balanced
TSN_RPC_PROVIDER_TIMEOUT_MS=4500
TSN_RPC_GATEWAY_WS_PATH=/ws
TSN_RPC_GATEWAY_ALLOW_ANY_ORIGIN=false
TSN_RPC_GATEWAY_LOG_LEVEL=info

TSN_RPC_GATEWAY_PROBE_INTERVAL_MS=300000
TSN_RPC_GATEWAY_PROBE_TIMEOUT_MS=2500
# Request-driven by default. Set to scheduled only for continuous probes.
TSN_RPC_GATEWAY_PROBE_MODE=on-demand
TSN_RPC_GATEWAY_DASHBOARD_REFRESH_MS=30000

# Production: list only browser origins that may make direct RPC calls.
# Keep this empty when all browser traffic is proxied by the TrustLink backend.
TSN_RPC_GATEWAY_ALLOWED_ORIGINS=https://trustlink-pay.vercel.app https://trustlink-pay-backend.vercel.app http://localhost:3001

# Local-only override. Never enable in a public deployment.

# HTTP JSON-RPC is served at / or /rpc.
# WebSocket subscriptions are served on the same public port at /ws.

# Upstream Solana HTTP RPC providers used by the gateway
TSN_SOLANA_RPC_URLS=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,https://api.devnet.solana.com

# Optional explicit upstream WebSocket providers.
# If omitted, the gateway derives ws/wss URLs from TSN_SOLANA_RPC_URLS.
TSN_SOLANA_WS_URLS=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY,wss://api.devnet.solana.com
