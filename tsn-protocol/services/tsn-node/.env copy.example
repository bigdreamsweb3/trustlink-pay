# TSN Node shared Firebase/Receiver configuration.
# Copy this file to .env and replace every placeholder value.
MEMPOOL_STORE=firebase
MEMPOOL_FILE=.mempool-store.json
TSN_ALLOW_LOCAL_JSON_STORE=false
FIREBASE_CREDENTIALS=.fb_creds/your-firebase-adminsdk.json
FIREBASE_PROJECT_ID=tsn-epoch-record
FIREBASE_COLLECTION=tsn_mempool
# Use FIREBASE_CREDENTIALS above, or provide these three fields instead.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-your-service-account@tsn-epoch-record.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
TSN_RECEIVER_NODE_API_KEY=replace-with-the-shared-node-service-credential
TSN_NODE_ID=tsn-node-devnet-1
TSN_NODE_ALLOWED_ORIGINS=https://tsn-receiver-kappa.vercel.app
TSN_RECEIVER_URL=https://tsn-receiver-kappa.vercel.app
TSN_RECEIVER_FALLBACK_URL=https://tsn-receiver-kappa.vercel.app
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TSN_RPC_GATEWAY_URL=https://tsn-rpc-gateway.vercel.app
HOST=0.0.0.0
PORT=8000
