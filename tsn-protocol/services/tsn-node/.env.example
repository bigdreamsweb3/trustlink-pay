# TSN Mempool â€” environment variables
# Copy this to .env and fill in your values

# Required: GitHub PAT with Contents:Write on bigdreamsweb3/tsn-epoch-records
GITHUB_TOKEN=ghp_your_token_here

# Required Firebase Admin credentials.
# TSN mempool live state is stored in Firebase Firestore.
MEMPOOL_FILE=.mempool-store.json
TSN_RECEIVER_NODE_API_KEY=replace-with-the-shared-node-service-credential
# Dedicated Ed25519 seed that signs every Node verification/rejection receipt.
# Generate a fresh key; configure its matching public key in Receiver and Cranker.
TSN_NODE_VERIFICATION_SIGNING_KEY=
# Mother authority Solana JSON keypair used only by the Node to co-sign
# Node-verified TCAP settlement messages. Never configure this in Cranker.
TSN_MOTHER_AUTHORITY_KEYPAIR_PATH=
TSN_ROUTE_ATTESTATION_SIGNING_KEY=base64-encoded-64-byte-ed25519-secret
TSN_NODE_ID=tsn-node-devnet-1
TSN_NODE_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,https://tsn-receiver-kappa.vercel.app
# Never enable this in a deployed Receiver or TSN Node. It exists only for
# isolated local tests that intentionally exercise the JSON adapter.
TSN_ALLOW_LOCAL_JSON_STORE=false

# Option A: point to a Firebase service-account JSON file.

# Option B: provide service-account fields directly.

# Optional: Firestore root collection used by this service.

# Required: TSN settlement program to scan for epoch treasury and CrankerVault accounts.
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
# Optional preferred RPC; defaults to the TSN RPC gateway.
TSN_RPC_URL=https://tsn-rpc-gateway.vercel.app

# Optional: supported SPL tokens and valuation metadata used by /network/overview.
# unitPriceUsd is required when a stable token is not exactly $1, because active
# vault liquidity is reported in USD.
# SOLANA_ALLOWED_SPL_TOKENS=[{"mintAddress":"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU","symbol":"USDC","name":"USD Coin","decimals":6,"unitPriceUsd":1}]

# Optional: port to listen on (default 8000)
HOST=127.0.0.1
PORT=8000

# Required outside local development. Shared only with trusted backend services
# and Cranker daemons; never expose this value to browser code.
MEMPOOL_API_KEY=

# Shared only with the trusted TIN issuer and Node. Never expose this lookup
# secret to browsers, Receiver, or Cranker. Provision a random value of at least
# 16 bytes through the secret manager; do not use a public/default namespace.
TINS_LOOKUP_SECRET=

# Dedicated Ed25519 seed used only to sign atomic threshold-access nonce
# receipts. It cannot decrypt TIN data or authorize token movement. Generate a
# separate 32-byte value; never reuse a wallet, Cranker, route, or program key.
TSN_THRESHOLD_NONCE_SIGNING_KEY=

# Separate signing key for immutable epoch-slot settlement authorizations.
# It never decrypts TIN data and never reconstructs a user authority.
TSN_SETTLEMENT_AUTHORIZATION_SIGNING_KEY=


TSN_RECEIVER_URL=https://tsn-receiver-kappa.vercel.app
TSN_RECEIVER_FALLBACK_URL=https://tsn-receiver-kappa.vercel.app
# The Receiver wakes the Node after durable work is committed. The Node does
# not poll while idle. This only bounds a wake HTTP request from the Receiver.
TSN_PRIVATE_PERMIT_TTL_SECS=90
TSN_NODE_CLAIM_SLOT_HMAC_SECRET=replace-with-32-byte-random-secret
TSN_LEASE_AUTH_MAX_AGE_SECS=60


# Optional: hours per epoch (default 7)
EPOCH_HOURS=7
VAULT_LIQUIDITY_REFRESH_SECS=25200
CLAIM_PROCESSING_TIMEOUT_SECS=300
CRANKER_HEARTBEAT_TTL_SECS=30

# Temporary Devnet-only compatibility switch. Keep false in production.
TSN_ALLOW_SINGLE_CRANKER_TINS=false

# Public vault metadata used by settlement accounting.

# Local hidden-head witness snapshots are selected only by the confirmed
# TCAP/TIP roots. No private paths are accepted from Receiver or Cranker.
GPRU_HIDDEN_HEAD_WITNESS_DIR=
# Explicit matching artifacts; no automatic setup or development-key fallback.
GPRU_CIRCUIT_BUILD_DIR=
GPRU_CIRCUIT_WASM_PATH=
GPRU_PROVING_KEY_PATH=
GPRU_VERIFICATION_KEY_PATH=
GPRU_PROVER_METADATA_PATH=
# Pin the reviewed manifest, including circuitSourceSha256 and all artifacts.
GPRU_PROVER_METADATA_SHA256=
# Separate complete-credit-epoch circuit/key; pin this metadata independently.
GPRU_EPOCH_CIRCUIT_BUILD_DIR=
GPRU_EPOCH_CIRCUIT_WASM_PATH=
GPRU_EPOCH_PROVING_KEY_PATH=
GPRU_EPOCH_VERIFICATION_KEY_PATH=
GPRU_EPOCH_PROVER_METADATA_PATH=
GPRU_EPOCH_PROVER_METADATA_SHA256=
GPRU_NODE_EXECUTABLE=node
TSN_GPRU_CREDIT_TTL_SLOTS=2000

# Local Node cache: metadata and encrypted exact replies; never lease authority.
TSN_NODE_CACHE_DIR=.node-cache
# A single prover process is shared across credit, debit and accounting.
# Heap MB and initial WASM pages are not an operating-system RSS limit.
TSN_PROVER_HEAP_MB=2048
TSN_PROVER_WASM_PAGES=8192
