#
SOLANA_MOCK_MODE=false
# Crankers use the TrustLink Labs TSN RPC Gateway for all Solana reads and
# submissions while the network is in experimental Devnet operation.
TSN_RPC_GATEWAY_URL=https://tsn-rpc-gateway.vercel.app
# The gateway's websocket endpoint is optional; leave it unset unless the
# deployed gateway exposes websocket subscriptions for this operator.
SOLANA_WS_URL=
TSN_ENABLE_SOLANA_SUBSCRIPTIONS=false
PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TINS_PROGRAM_ID=TinseNnU588NkmRZBe4ADJbxqrqQma92678UFP6VuwT
KEYPAIR_PATH=./keys/cranker-keypair.json
# Optional aliases for secret-key based operator startup. Prefer KEYPAIR_PATH.
TSN_CRANKER_KEYPAIR_PATH=./keys/cranker-keypair.json
TSN_CRANKER_OPERATOR_SECRET_KEY=

# 
TSN_ENABLED=true
# Legacy v1 only. Private v2 routing is decrypted by the mempool verifier after
# the Cranker wins an authenticated lease.
TSN_CREATE_INTENTS_ONCHAIN=true
TSN_CRANKER_OPERATOR_PUBKEY=FnTrWDNgsXedkoCxpgKvwmEF3By4G6wzu9oyoU1n9xUG
# 
TSN_RECEIVER_URL=https://tsn-receiver-kappa.vercel.app
# Public key corresponding to the TSN Node's route-attestation signing key.
# This is verification metadata only; never put the Node private key here.
TSN_ROUTE_ATTESTATION_PUBLIC_KEY_BASE64=


# 
TSN_CRANKER_POLL_MS=2000
TSN_CRANKER_MAX_IDLE_POLL_MS=30000
TSN_CRANKER_TIN_POLL_MS=30000
TSN_CRANKER_WAKE_ENABLED=false
TSN_CRANKER_WAKE_FALLBACK_POLL_MS=300000
FIREBASE_DATABASE_URL=
TSN_MEMPOOL_API_KEY=
TSN_CRANKER_PDA=
TSN_ACTIVE_PEA_ADDRESSES=
TSN_PRIVACY_RECEIVE_ADDRESSES=
TSN_CRANKER_PRIORITY_FEE_MICROLAMPORTS=
TSN_CRANKER_PRIORITY_FEE_CAP_MICROLAMPORTS=250000
TSN_CRANKER_TOKEN_DECIMALS=6
# Idle Crankers back off exponentially up to this limit. Keep the base poll
# short enough for fresh Solana authorizations, but avoid repeated Receiver
# reads while the queue is empty.
TSN_CRANKER_TOKEN_USD=1
TSN_CRANKER_SOL_USD=150
TSN_CRANKER_OPERATOR_FEE_UI=0.02
TSN_CRANKER_SAFETY_MULTIPLIER=1.25
TSN_CRANKER_EXECUTION_LAMPORTS=20000
TSN_CRANKER_ATA_LAMPORTS=2039280
