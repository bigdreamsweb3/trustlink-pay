# Production: free Cloudflare D1 record store, accessed only by Receiver.
TSN_RECEIVER_STORE=d1
TSN_RECORD_STORE_URL=https://[TO FILL: your private record-store Worker hostname]
TSN_RECORD_STORE_TOKEN=
TSN_RECORD_STORE_NAMESPACE=tsn-receiver

# Isolated local tests only: set STORE=file and ALLOW_LOCAL_JSON_STORE=true together.
TSN_ALLOW_LOCAL_JSON_STORE=false
TSN_RECEIVER_LOCAL_FILE=.receiver-store.json
TSN_RECEIVER_COLLECTION=tsn_receiver_work
TSN_RECEIVER_STATE_COLLECTION=tsn_receiver_state
TSN_RECEIVER_CRANKER_CHALLENGE_COLLECTION=tsn_receiver_cranker_challenges
TSN_RECEIVER_CRANKER_RATE_COLLECTION=tsn_receiver_cranker_rate_limits
TSN_RECEIVER_CRANKER_SESSION_COLLECTION=tsn_receiver_cranker_sessions
TSN_RECEIVER_NODE_API_KEY=
TSN_NODE_VERIFICATION_PUBLIC_KEY=
# Existing encryption key for restricted ingress. Preserve it during data migration.
TSN_RECEIVER_NODE_PAYLOAD_KEY=
TSN_RPC_URL=https://tsn-rpc-gateway.vercel.app
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TSN_RECEIVER_PUBLIC_URL=https://tsn-receiver-kappa.vercel.app
# Node stays local and retrieves durable requests; browser never receives storage credentials.
