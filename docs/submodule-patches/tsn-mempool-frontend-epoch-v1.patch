+import { listEpochChallenges, listEpochs, maskTsnValue } from "../lib/epochSettlement";
+
+export async function EpochSettlementPanel() {
+  const [epochs, challenges] = await Promise.all([
+    listEpochs().catch(() => []),
+    listEpochChallenges().catch(() => []),
+  ]);
+
+  return (
+    <section className="rounded-2xl border border-slate-800 bg-slate-950 p-6 text-slate-100">
+      <div className="mb-6">
+        <p className="text-sm uppercase tracking-wide text-cyan-300">TSN epoch settlement</p>
+        <h2 className="mt-2 text-2xl font-semibold">PEA, commitments, and Cranker recovery race</h2>
+        <p className="mt-3 max-w-3xl text-sm text-slate-300">
+          This explorer shows epoch health without exposing TINS routes, OTDT payloads, phone numbers, raw wallet
+          addresses, or the private payment graph. Epoch roots and aggregate math are public; individual settlement
+          paths stay inside the Mempool runtime and authorised Cranker flow.
+        </p>
+      </div>
+
+      <div className="grid gap-4 lg:grid-cols-3">
+        {epochs.slice(0, 6).map((epoch) => (
+          <article key={epoch.id} className="rounded-xl border border-slate-800 bg-slate-900 p-4">
+            <div className="flex items-center justify-between gap-3">
+              <h3 className="font-semibold">Epoch {epoch.epochId}</h3>
+              <span className="rounded-full bg-cyan-950 px-3 py-1 text-xs text-cyan-200">{epoch.status}</span>
+            </div>
+            <dl className="mt-4 space-y-2 text-sm">
+              <div className="flex justify-between gap-3">
+                <dt className="text-slate-400">Commitments</dt>
+                <dd>{epoch.commitmentCount}</dd>
+              </div>
+              <div className="flex justify-between gap-3">
+                <dt className="text-slate-400">Total</dt>
+                <dd>{epoch.totalToDistribute}</dd>
+              </div>
+              <div className="flex justify-between gap-3">
+                <dt className="text-slate-400">PEA</dt>
+                <dd>{maskTsnValue(epoch.pea)}</dd>
+              </div>
+              <div className="flex justify-between gap-3">
+                <dt className="text-slate-400">Root</dt>
+                <dd>{maskTsnValue(epoch.rootHash)}</dd>
+              </div>
+              <div className="flex justify-between gap-3">
+                <dt className="text-slate-400">Winner</dt>
+                <dd>{maskTsnValue(epoch.winnerCrankerPubkey)}</dd>
+              </div>
+            </dl>
+          </article>
+        ))}
+      </div>
+
+      <div className="mt-8 rounded-xl border border-slate-800 bg-slate-900 p-4">
+        <h3 className="font-semibold">Open recovery challenges</h3>
+        <div className="mt-4 overflow-x-auto">
+          <table className="min-w-full text-left text-sm">
+            <thead className="text-slate-400">
+              <tr>
+                <th className="py-2 pr-4">Epoch</th>
+                <th className="py-2 pr-4">Status</th>
+                <th className="py-2 pr-4">Root</th>
+                <th className="py-2 pr-4">Total</th>
+                <th className="py-2 pr-4">Winner</th>
+              </tr>
+            </thead>
+            <tbody>
+              {challenges.map((challenge) => (
+                <tr key={challenge.id} className="border-t border-slate-800">
+                  <td className="py-2 pr-4">{challenge.epoch}</td>
+                  <td className="py-2 pr-4">{challenge.status}</td>
+                  <td className="py-2 pr-4">{maskTsnValue(challenge.rootHash)}</td>
+                  <td className="py-2 pr-4">{challenge.totalToDistribute}</td>
+                  <td className="py-2 pr-4">{maskTsnValue(challenge.winnerCrankerPubkey)}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </section>
+  );
+}
