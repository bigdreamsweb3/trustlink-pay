{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node", "mocha"],
    "typeRoots": ["./node_modules/@types", "../backend/node_modules/@types"],
    "paths": {
      
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["programs/tests/**/*.ts"]
}
