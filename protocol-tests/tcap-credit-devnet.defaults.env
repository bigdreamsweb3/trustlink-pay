# Checked-in, non-secret Devnet record directory for the TCAP credit bootstrap.
# Update these values when the governed Devnet records or program deployments change.
# Bootstrap derives each PDA canonically and verifies its account owner and presence;
# these values are not trusted as authorization, roots, intents, or private material.
TCAP_PROGRAM_ID=TcApT4CytBqvqEDpRYVB7Wfi6aFzmtSZdWvDsq6bp9x
TSN_PROGRAM_ID=TSN31jddtsmUg4D5aEdhY31nwB1e53VJJg9X8NoRP8V
TCAP_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
TCAP_RPC_URL=https://api.devnet.solana.com
# Devnet USDC is a 6-decimal classic SPL mint; bootstrap verifies this on-chain.
TCAP_MINT_DECIMALS=6
# 1 USDC in base units under the verified six-decimal profile.
TCAP_AMOUNT=1000000
TCAP_DEPOSIT_AMOUNT=1000000
# Explicit Devnet fixture snapshot; stable_units is expressed in whole USDC.
TCAP_TOKEN_BALANCES_JSON=[{"token_id":1,"native_amount":"1000000","stable_units":"1","stable_rate_version":1}]
# Devnet bootstrap may be followed by a program upgrade before credit smoke.
# Keep the authorization valid long enough for that operational path.
TCAP_VALIDITY_WINDOW_SLOTS=10000
TCAP_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
TSN_MOTHER_ESCROW=ETNJWb2KDNdHSscVNbEiz1iWboddZdr8EPgmzw53hNkR
# Local protected signer path; the keypair file is never checked in.
TSN_MOTHER_AUTHORITY_WALLET=tsn-protocol/tsn-node/keys/tsn-mother-authority.json
TCAP_VAULT=2R76WD9xbzt3yMHtXEBLoxEbi2bkXYN9Hpk8nQoxsAnh
TCAP_ONE_TIME_TIP=6ZS66tZLLuEFKovAjzb5vRLLMqqEJUia8UMr4hBNdWLj
# The V2 runner derives the fixture tip root from this label and the Mother
# authority public key when TCAP_TIP_ROOT_COMMITMENT is not supplied. Set the
# explicit 64-character hex root only when the initialized tip used another
# identity label or a separately generated root.
TCAP_DEVNET_TEST_IDENTITY_LABEL=fixture-wallet-v1
# Existing initialized Devnet fixture tip root (32-byte commitment, hex). This
# is the raw seed used to derive TCAP_TIP; TCAP_COMMITMENT_ROOT is a different
# PDA and must not be supplied here.
TCAP_TIP_ROOT_COMMITMENT=9fd26b1250199d824daabae987161cdeda3861511413181704a9d424b09c5840
# TCAP_SOURCE_TOKEN_ACCOUNT is optional when the Mother's associated token
# account exists; the V2 runner derives that ATA from the signer and mint.
# TCAP_SOURCE_TOKEN_ACCOUNT=
# TCAP_RPC_URL is optional; export a Helius/provider Devnet URL in the shell
# for this run instead of committing an API key to this file.
# Local protected governance signer path; the keypair file is never checked in.
TCAP_GOVERNANCE_KEYPAIR=~/.config/solana/id.json
TCAP_GOVERNANCE_WALLET=~/.config/solana/id.json
TCAP_CONFIG=2Q48b1TAhJECiGtLwMirvyNerFSBUBcpQvCPPemQryVY
TCAP_ASSET_REGISTRY=6oGZV9yt5M6uPH66UZPhJZsGsqfJg2Ec1mtV8VEjQjbE
TCAP_COMMITMENT_ROOT=DG41e3M1hvmw1cgo8cEK2w9UDcCjkrUXdyghhWZJfwbd
TCAP_ASSET_ENTRY=GzZboGDkJTDpRredv6N5GSwF1Gb9BD6KHeHyprczsFbW
TCAP_RESERVE_STATE=3f6KxF1FRPY4ntyXxr1RbMEMwMHngV7vMGcAdBKdEc5d
# Default Devnet wallet used by the optional exit fixture; override per test.
TCAP_EXIT_DESTINATION_WALLET=GRx2SwHBhqpBWc8NtQBSJHDcZAh6EioEjtxBdtufY4i6
TCAP_GOVERNANCE_POLICY=25ybwaZrW5o57mtjZvsqUBDEYheTgWUyEoRjWGtUNFH8
TCAP_EXTENSION_POLICY=CwXQNL6NB4yMrACVox1wnoBMw42NreN55QBnrAMUrow7
TCAP_EMPTY_TREE_ROOT_HEX=47f64a304f10f65277568d1a061f669389cca93a55cac74712d7c1d99dddedff
