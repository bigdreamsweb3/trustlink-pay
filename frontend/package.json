{
  "name": "trust-link-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "NODE_ENV=development npm --prefix ../utils/observability ci --include=dev && npm --prefix ../utils/observability run build && NODE_ENV=development npm --prefix ../packages/trustlink-whatsapp-sdk ci --include=dev && npm --prefix ../packages/trustlink-whatsapp-sdk run build && npm --prefix ../tsn-protocol/tsn-sdk ci && npm --prefix ../tsn-protocol/tsn-sdk run build",
    "dev": "npm run seo:generate && next dev -p 3001",
    "build": "npm run seo:generate && next build",
    "start": "next start -p 3001",
    "typecheck": "npm run seo:generate && tsc --noEmit",
    "ngrok:https": "npx ngrok http 3001",
    "dev:turbo": "npm run seo:generate && NODE_OPTIONS='--max-old-space-size=4096' TRUSTLINK_TURBOPACK_DEV=1 next dev --turbo -p 3001",
    "seo:generate": "node scripts/seo/generate-public-routes.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@reown/appkit": "^1.8.22",
    "@reown/appkit-adapter-solana": "^1.8.22",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@trustlink/observability": "file:../utils/observability",
    "@trustlink/tsn-sdk": "file:../tsn-protocol/tsn-sdk",
    "framer-motion": "^12.39.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.473.0",
    "next": "14.2.26",
    "postcss": "^8.5.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0",
    "trustlink-whatsapp-sdk": "file:../packages/trustlink-whatsapp-sdk",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.5"
  }
}
