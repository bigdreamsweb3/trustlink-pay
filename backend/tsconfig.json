{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@trustlink/tsn-sdk": ["../tsn-protocol/tsn-sdk/dist"],
      "@trustlink/tsn-sdk/*": ["../tsn-protocol/tsn-sdk/dist/*"],
      "@trustlink/tsn-cranker-sdk": ["../tsn-protocol/tsn-cranker-sdk/src"],
      "@trustlink/tins-sdk": ["../tin-system/tins-sdk/src"],
      "@coral-xyz/anchor": ["./node_modules/@coral-xyz/anchor"],
      "@solana/spl-token": ["./node_modules/@solana/spl-token"],
      "@solana/web3.js": ["./node_modules/@solana/web3.js"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "frontend",
    "tests",
    "scripts/test-tins-*",
    "../tin-system/tins-sdk",
    "../tsn-protocol/tsn-sdk",
    "../tsn-protocol/tsn-cranker-sdk"
  ]
}
