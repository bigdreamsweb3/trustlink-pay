{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../backend/node_modules/@types"],
    "paths": {
      "@/*": ["../backend/*"],
      "@coral-xyz/anchor": ["../backend/node_modules/@coral-xyz/anchor"],
      "@solana/spl-token": ["../backend/node_modules/@solana/spl-token"],
      "@solana/web3.js": ["../backend/node_modules/@solana/web3.js"],
      "@trustlink/tsn-sdk": ["../tsn-sdk/dist"],
      "@trustlink/tsn-sdk/*": ["../tsn-sdk/dist/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["scripts/**/*.ts"]
}
